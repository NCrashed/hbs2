cabal-version:      3.0
name:               hbs2-hub
version:            0.25.5.0
synopsis:           hbs2-hub: decentralized forge (issues/PRs) over hbs2
license:            BSD-3-Clause
license-file:       LICENSE
author:             Anton Gushcha
category:           System
build-type:         Simple

-- Shared warnings/extensions only. RTS and linker options belong to
-- executables and test binaries, not to the library, so they are set per
-- stanza rather than here.
common shared-properties
  ghc-options:
        -Wall
        -Wunused-packages
        -fno-warn-type-defaults
        -O2

  default-language: GHC2021

  default-extensions:
                       ApplicativeDo
                     , BangPatterns
                     , BlockArguments
                     , ConstraintKinds
                     , DataKinds
                     , DeriveDataTypeable
                     , DeriveGeneric
                     , DerivingStrategies
                     , DerivingVia
                     , ExtendedDefaultRules
                     , FlexibleContexts
                     , FlexibleInstances
                     , GADTs
                     , GeneralizedNewtypeDeriving
                     , ImportQualifiedPost
                     , LambdaCase
                     , MultiParamTypeClasses
                     , OverloadedStrings
                     , QuasiQuotes
                     , RecordWildCards
                     , ScopedTypeVariables
                     , StandaloneDeriving
                     , TupleSections
                     , TypeApplications
                     , TypeFamilies
                     , PatternSynonyms
                     , ViewPatterns

library
    import:           shared-properties
    hs-source-dirs:   lib
    -- Declared per stanza and not in the shared block: a dependency every stanza
    -- inherits is one -Wunused-packages can never say anything useful about.
    build-depends:    base
                    , suckless-conf
                    , hbs2-core
                    , serialise
                    , unordered-containers
                    , hashable
                    , cborg
                    , bytestring
                    , text
                    , prettyprinter
                    , saltine
                    , time
                    , base64-bytestring
    exposed-modules:
      HBS2.Hub.Types
      HBS2.Hub.Fold
      HBS2.Hub.Letter
      HBS2.Hub.Bridge
      HBS2.Hub.Canon
      HBS2.Hub.Compact
      HBS2.Hub.Manifest
      HBS2.Hub.Repo

-- Everything that knows about the network, in a sublibrary rather than inside
-- the executable.
--
-- The library above is pure by design (PEP-22 "Principle"), which is what lets
-- the whole admission surface be property-tested without a peer, a socket or a
-- clock. Everything that talks to hbs2-peer, decrypts, or reads a mailbox lives
-- here, so the seam is a package boundary rather than a convention.
--
-- A sublibrary and not `other-modules` of the executable, because a module a
-- test cannot import is a module with no tests: the ingress has pure decisions
-- in it (which messages a mailbox tree still holds, what a letter turned out to
-- be) and those were unreachable while they lived in the exe.
library hub-ingress
    import:           shared-properties
    visibility:       public
    hs-source-dirs:   ingress
    build-depends:    base
                    , hbs2-hub
                    , hbs2-core
                    , hbs2-peer
                    , hbs2-cli
                    , hbs2-keyman-direct-lib
                    , bytestring
                    , serialise
                    , time
                    , typed-process
                    , process
                    , unix
                    , unordered-containers
                    , text
                    , mtl
                    , saltine
                    , filepath
                    , streaming
                    , containers
                    , suckless-conf
                    , directory
    exposed-modules:
      HBS2.Hub.Deny
      HBS2.Hub.Ingress
      HBS2.Hub.Sent
      HBS2.Hub.Repo.Git
      HBS2.Hub.Repo.Manifest
      HBS2.Hub.Repo.GitBundle
      HBS2.Hub.Repo.GitWrite
      HBS2.Hub.CLI.Ack
      HBS2.Hub.CLI.Argv
      HBS2.Hub.CLI.Ban
      HBS2.Hub.CLI.Comment
      HBS2.Hub.CLI.Compose
      HBS2.Hub.CLI.Drop
      HBS2.Hub.CLI.Accept
      HBS2.Hub.CLI.Inbox
      HBS2.Hub.CLI.Maintainer
      HBS2.Hub.CLI.Own
      HBS2.Hub.CLI.Policy
      HBS2.Hub.CLI.Pr
      HBS2.Hub.CLI.Read
      HBS2.Hub.CLI.Reject
      HBS2.Hub.CLI.Show
      HBS2.Hub.CLI.Sync
      HBS2.Hub.CLI.Updates
      HBS2.Hub.CLI.Verify

-- The CLI itself.
--
-- Named hbs2-hub, like every other binary in this repository except the one git
-- names for us. `hub` is a widely installed GitHub tool, so the PEP-22 surface
-- is reached through a symlink rather than by claiming the name in PATH.
executable hbs2-hub
    import:           shared-properties
    hs-source-dirs:   app
    main-is:          Main.hs
    ghc-options:
        -threaded
        -rtsopts
        "-with-rtsopts=-N4 -A64m"
    build-depends:    base
                    , hbs2-hub
                    , hbs2-hub:hub-ingress
                    , hbs2-cli
                    , suckless-conf
                    , text
                    , unordered-containers

test-suite spec
  import:          shared-properties
  type:            exitcode-stdio-1.0
  main-is:         Spec.hs
  hs-source-dirs:  test
  ghc-options:
      -threaded
      -rtsopts
      -with-rtsopts=-N
  build-tool-depends:
      hspec-discover:hspec-discover
  build-depends:   base
                 , hbs2-hub
                 , hbs2-hub:hub-ingress
                 , hbs2-peer
                 , hbs2-core
                 , suckless-conf
                 , hspec
                 , QuickCheck
                 , base16-bytestring
                 , bytestring
                 , serialise
                 , unordered-containers
                 , saltine
                 , text
                 , directory
                 , filepath
                 , temporary
                 , time
                 , typed-process
                 , prettyprinter
                 , unix
                 , unliftio
                 -- For planting a loose object git would not write: one whose
                 -- header announces a size its body does not have. See
                 -- 'lyingObject' in HBS2.Hub.GitRepoSpec.
                 , zlib
                 , cryptohash-sha1
  other-modules:
      HBS2.Hub.AcceptSpec
      HBS2.Hub.ArgvSpec
      HBS2.Hub.CommentSpec
      HBS2.Hub.CompactSpec
      HBS2.Hub.ComposeSpec
      HBS2.Hub.InboxSpec
      HBS2.Hub.SyncSpec
      HBS2.Hub.TextSpec
      HBS2.Hub.FoldSpec
      HBS2.Hub.LetterSpec
      HBS2.Hub.ManifestSpec
      HBS2.Hub.BanSpec
      HBS2.Hub.BridgeSpec
      HBS2.Hub.CanonSpec
      HBS2.Hub.MaintainerSpec
      HBS2.Hub.OwnSpec
      HBS2.Hub.PolicySpec
      HBS2.Hub.PrSpec
      HBS2.Hub.PropertySpec
      HBS2.Hub.IngressSpec
      HBS2.Hub.ReadSpec
      HBS2.Hub.RejectSpec
      HBS2.Hub.RepoSpec
      HBS2.Hub.SentSpec
      HBS2.Hub.ShowSpec
      HBS2.Hub.GitBundleSpec
      HBS2.Hub.GitRepoSpec
      HBS2.Hub.GitWriteSpec
      HBS2.Hub.UpdatesSpec
      HBS2.Hub.VerifySpec
