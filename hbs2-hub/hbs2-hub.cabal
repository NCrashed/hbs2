cabal-version:      3.0
name:               hbs2-hub
version:            0.25.5.0
synopsis:           hbs2-hub: decentralized forge (issues/PRs) over hbs2
license:            BSD-3-Clause
license-file:       LICENSE
author:             Anton Gushcha
category:           System
build-type:         Simple

-- Shared warnings/extensions only. RTS and linker options belong to
-- executables and test binaries, not to the library, so they are set per
-- stanza rather than here.
common shared-properties
  ghc-options:
        -Wall
        -fno-warn-type-defaults
        -O2

  default-language: GHC2021

  default-extensions:
                       ApplicativeDo
                     , BangPatterns
                     , BlockArguments
                     , ConstraintKinds
                     , DataKinds
                     , DeriveDataTypeable
                     , DeriveGeneric
                     , DerivingStrategies
                     , DerivingVia
                     , ExtendedDefaultRules
                     , FlexibleContexts
                     , FlexibleInstances
                     , GADTs
                     , GeneralizedNewtypeDeriving
                     , ImportQualifiedPost
                     , LambdaCase
                     , MultiParamTypeClasses
                     , OverloadedStrings
                     , QuasiQuotes
                     , RecordWildCards
                     , ScopedTypeVariables
                     , StandaloneDeriving
                     , TupleSections
                     , TypeApplications
                     , TypeFamilies
                     , PatternSynonyms
                     , ViewPatterns

  build-depends:
        hbs2-core
      , suckless-conf
      , serialise
      , cborg
      , bytestring
      , containers
      , unordered-containers
      , hashable
      , text

library
    import:           shared-properties
    hs-source-dirs:   lib
    build-depends:    base
    exposed-modules:
      HBS2.Hub.Types
      HBS2.Hub.Fold
      HBS2.Hub.Letter
      HBS2.Hub.Bridge
      HBS2.Hub.Manifest

test-suite spec
  import:          shared-properties
  type:            exitcode-stdio-1.0
  main-is:         Spec.hs
  hs-source-dirs:  test
  ghc-options:
      -threaded
      -rtsopts
      -with-rtsopts=-N
  build-tool-depends:
      hspec-discover:hspec-discover
  build-depends:   base
                 , hbs2-hub
                 , hbs2-core
                 , suckless-conf
                 , hspec
                 , unordered-containers
                 , text
  other-modules:
      HBS2.Hub.FoldSpec
      HBS2.Hub.LetterSpec
      HBS2.Hub.ManifestSpec
      HBS2.Hub.BridgeSpec
