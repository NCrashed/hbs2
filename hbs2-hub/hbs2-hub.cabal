cabal-version:      3.0
name:               hbs2-hub
version:            0.25.5.0
synopsis:           hbs2-hub: decentralized forge (issues/PRs) over hbs2
license:            BSD-3-Clause
license-file:       LICENSE
author:             Anton Gushcha
category:           System
build-type:         Simple

-- Shared warnings/extensions only. RTS and linker options belong to
-- executables and test binaries, not to the library, so they are set per
-- stanza rather than here.
common shared-properties
  ghc-options:
        -Wall
        -Wunused-packages
        -fno-warn-type-defaults
        -O2

  default-language: GHC2021

  default-extensions:
                       ApplicativeDo
                     , BangPatterns
                     , BlockArguments
                     , ConstraintKinds
                     , DataKinds
                     , DeriveDataTypeable
                     , DeriveGeneric
                     , DerivingStrategies
                     , DerivingVia
                     , ExtendedDefaultRules
                     , FlexibleContexts
                     , FlexibleInstances
                     , GADTs
                     , GeneralizedNewtypeDeriving
                     , ImportQualifiedPost
                     , LambdaCase
                     , MultiParamTypeClasses
                     , OverloadedStrings
                     , QuasiQuotes
                     , RecordWildCards
                     , ScopedTypeVariables
                     , StandaloneDeriving
                     , TupleSections
                     , TypeApplications
                     , TypeFamilies
                     , PatternSynonyms
                     , ViewPatterns

  -- Only what every stanza needs. What the library alone needs is declared
  -- there, so -Wunused-packages stays useful instead of being noise the CLI
  -- inherits.
  build-depends:
        hbs2-core
      , suckless-conf
      , serialise
      , unordered-containers

library
    import:           shared-properties
    hs-source-dirs:   lib
    build-depends:    base
                    , cborg
                    , bytestring
                    , text
                    , prettyprinter
                    , saltine
                    , base64-bytestring
    exposed-modules:
      HBS2.Hub.Types
      HBS2.Hub.Fold
      HBS2.Hub.Letter
      HBS2.Hub.Bridge
      HBS2.Hub.Canon
      HBS2.Hub.Manifest

-- The CLI, and the only stanza here that knows about the network.
--
-- The library above is pure by design (PEP-22 "Principle"), which is what lets
-- the whole admission surface be property-tested without a peer, a socket or a
-- clock. Everything that talks to hbs2-peer, decrypts, or reads a mailbox lives
-- here, so the seam between "what the rules are" and "where the bytes come
-- from" is a package boundary rather than a convention.
executable hub
    import:           shared-properties
    hs-source-dirs:   app
    main-is:          Main.hs
    ghc-options:
        -threaded
        -rtsopts
        "-with-rtsopts=-N4 -A64m"
    build-depends:    base
                    , hbs2-hub
                    , hbs2-peer
                    , hbs2-cli
                    , hbs2-keyman-direct-lib
    other-modules:
      HBS2.Hub.CLI.Inbox

test-suite spec
  import:          shared-properties
  type:            exitcode-stdio-1.0
  main-is:         Spec.hs
  hs-source-dirs:  test
  ghc-options:
      -threaded
      -rtsopts
      -with-rtsopts=-N
  build-tool-depends:
      hspec-discover:hspec-discover
  build-depends:   base
                 , hbs2-hub
                 , hbs2-core
                 , suckless-conf
                 , hspec
                 , QuickCheck
                 , base16-bytestring
                 , bytestring
                 , serialise
                 , unordered-containers
                 , text
  other-modules:
      HBS2.Hub.FoldSpec
      HBS2.Hub.LetterSpec
      HBS2.Hub.ManifestSpec
      HBS2.Hub.BridgeSpec
      HBS2.Hub.CanonSpec
      HBS2.Hub.PropertySpec
